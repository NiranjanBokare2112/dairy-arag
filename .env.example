# Copy to .env and fill in. Never commit .env.

# App
APP_SECRET=
DATABASE_PATH=
CENTER_ID=arag
DATABASE_URL=postgresql+psycopg://arag_app:CHANGE_ME@localhost:5432/arag_dudh
TEST_DATABASE_URL=postgresql+psycopg://arag_app:CHANGE_ME@localhost:5432/arag_dudh_test

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret (checks that delivery reports really come from Meta). Secret.
WHATSAPP_APP_SECRET=
# Graph API version (Meta retires old ones; change when Meta announces)
WHATSAPP_API_VERSION=v23.0
# SAFETY: until WHATSAPP_LIVE=1 messages go ONLY to these numbers (comma separated, 10 digits)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_LIVE=0

# SMS gateway (Android phone on the LAN)
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_DAILY_CAP=95

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_HOSTNAME=

# Backups (docs/backup-restore.md)
# Off-site folder kept in sync by a cloud drive, e.g. C:\Users\<owner>\Google Drive\Arag backups
BACKUP_DESTINATION=
# Optional: local folder (default: backups\ in the repo), how many to keep, PostgreSQL bin folder if not found
BACKUP_DIR=
BACKUP_KEEP=30
PG_BIN=

# Help tickets (D-109): Bokare support is told of every new ticket / reply here (email + WhatsApp)
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# outgoing mail for those alerts (any SMTP; leave empty until set up)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Supabase — the online copy of the database (D-134). Supabase → Project → Connect → "Session pooler" URI,
# written for SQLAlchemy: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Use:  python -m app.cli --supabase check   ·   python -m app.cli --supabase init-db   ·   python -m app.cli --supabase seed
SUPABASE_DATABASE_URL=
